# Copie para .env e ajuste os valores.

# --- Django ---------------------------------------------------------------
DJANGO_DEBUG=True
# Obrigatória em produção (DJANGO_DEBUG=False). Gere com:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=America/Sao_Paulo

# --- Banco de dados ---------------------------------------------------------
# Execução local sem Docker: vazio = SQLite (db.sqlite3). Para PostgreSQL:
# DATABASE_URL=postgres://usuario:senha@localhost:5432/lingualab
# No Docker esta variável é ignorada: o docker-compose aponta para o serviço "db".
DATABASE_URL=

# --- Docker (docker-compose.yml) ----------------------------------------------
POSTGRES_DB=lingualab
POSTGRES_USER=lingualab
POSTGRES_PASSWORD=lingualab
POSTGRES_PORT=5432
WEB_PORT=8000
# Em HTTP local deixe False; True ativa cookies seguros/HTTPS quando DJANGO_DEBUG=False.
DJANGO_HTTPS=False
# Intervalo (s) do agendador que encerra sessões abandonadas.
CLEANUP_INTERVAL_SECONDS=300

# --- Inteligência artificial (tradução e quizzes) ----------------------------
# "anthropic" usa o Claude; "mock" funciona offline (traduções simuladas e quizzes de lacuna).
# Se vazio: "anthropic" quando ANTHROPIC_API_KEY estiver definida, senão "mock".
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Esforço de raciocínio do modelo: low | medium | high | xhigh | max
AI_TRANSLATION_EFFORT=low
AI_QUIZ_EFFORT=medium
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2

# --- Áudio (Text-to-Speech) ---------------------------------------------------
# gtts = MP3 gerado no servidor (funciona em qualquer navegador); browser = voz do navegador.
TTS_PROVIDER=gtts
TTS_TIMEOUT_SECONDS=20

# --- Regras de negócio --------------------------------------------------------
TEXT_CHUNK_MAX_CHARS=500
QUIZ_SIMILARITY_THRESHOLD=0.85
# Limites do construtor de quiz e rodadas para substituir perguntas reprovadas na validação.
QUIZ_MAX_QUESTIONS=20
QUIZ_MAX_PER_KIND=10
QUIZ_GENERATION_ROUNDS=3
QUIZ_ATTEMPT_ABANDON_HOURS=24
DASHBOARD_REVIEW_THRESHOLD=70
DASHBOARD_MIN_ATTEMPTS=2
DASHBOARD_PRIOR_WEIGHT=2

# --- Cronômetro e sessões (segundos) ------------------------------------------
SESSION_INACTIVITY_TIMEOUT_SECONDS=1800
SESSION_INACTIVITY_WARNING_SECONDS=60
SESSION_ABANDON_TIMEOUT_SECONDS=600
SESSION_ACTIVE_GAP_SECONDS=300
SESSION_HEARTBEAT_SECONDS=60
STUDY_HEARTBEAT_SECONDS=20
STUDY_MAX_CREDIT_SECONDS=60
